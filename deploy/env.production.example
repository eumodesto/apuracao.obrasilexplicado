# Copy to .env.production on the server (never commit it) and fill in the blanks.
# Details of each variable: .env.example and docs/ACCESS_AND_PAYMENT.md.

# --- Server ---
# Public domain, without https:// (Caddy issues the certificate for it and redirects www.).
DOMAIN=portaleleicao.com.br
SITE_URL=https://portaleleicao.com.br

# --- Database ---
# Password of the Postgres container. Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# Leave empty to use the Postgres container above. For a DigitalOcean Managed Database, paste its
# connection string here (with ?sslmode=require).
DATABASE_URL=

# --- Login and payment ---
# At least 32 random characters: openssl rand -base64 32
SESSION_SECRET=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Access rules ---
FREE_SECONDS=60
ACCESS_PRICE_BRL=5.00
STAFF_EMAILS=
ADMIN_EMAILS=
COUNT_STARTS_AT=2026-10-25T17:00:00-03:00
PAID_ACCESS_ENDS_AT=2026-10-31T23:59:59-03:00

# --- TSE ---
TSE_POLL_INTERVAL_MS=3000
TSE_STALE_AFTER_MS=120000
# How often browsers ask this server for results (the TSE is still read every TSE_POLL_INTERVAL_MS).
CLIENT_POLL_INTERVAL_MS=10000

# Only needed with more than one app container (one process keeps the chat in memory).
REDIS_URL=
