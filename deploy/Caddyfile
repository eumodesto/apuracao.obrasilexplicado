# HTTPS with an automatic Let's Encrypt certificate for $DOMAIN, plus any EXTRA_DOMAINS
# (space-separated; e.g. a temporary 162-243-174-249.sslip.io while the DNS propagates).
{$DOMAIN} {$EXTRA_DOMAINS} {
	encode zstd gzip
	# flush_interval -1 keeps the chat's server-sent events streaming without buffering.
	reverse_proxy app:3000 {
		flush_interval -1
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
