# HTTPS with an automatic Let's Encrypt certificate for $DOMAIN, plus any EXTRA_DOMAINS
# (space-separated; e.g. a temporary 162-243-174-249.sslip.io while the DNS propagates).
(app) {
	reverse_proxy app1:3000 app2:3000 app3:3000 {
		# Each visitor stays on one process (its caches, its chat connection).
		lb_policy cookie rb_lb
		# Only a process that really stops answering is skipped: a busy one at peak is slow, not
		# down, and dropping all three at once answered 503 to everyone in the load test.
		health_uri /api/health
		health_interval 10s
		health_timeout 20s
		health_fails 3
		# A process that is restarting (deploys) refuses connections: try another one instead of
		# answering 502.
		lb_try_duration 5s
		lb_try_interval 250ms
		# Keeps the chat's server-sent events streaming without buffering.
		flush_interval -1
	}
}

{$DOMAIN} {$EXTRA_DOMAINS} {
	# The live chat is not compressed: compressing thousands of open streams costs more CPU than
	# the tiny events save.
	@stream path /api/chat/stream
	handle @stream {
		import app
	}

	# Static files never touch Node: Caddy serves them from /srv/static (filled at deploy by
	# deploy/publish-static.sh: Next's hashed build assets, `public/` and the icons), already
	# compressed on disk. Under load, serving ~60% of all requests (assets, favicon) from the Node
	# processes kept their event loops at 100% and stalled logins, APIs and the admin panel. A file
	# that is not on disk falls through to the app, so a missed publish degrades, not breaks.
	@static path /_next/static/* /maps/* /stickers/* /access/* /favicon.ico /apple-icon.png
	handle @static {
		route {
			# Hashed Next assets: long cache in the browser (names change every build).
			header /_next/static/* Cache-Control "public, max-age=31536000, immutable"
			header /maps/* Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
			header /stickers/* Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
			header /access/* Cache-Control "public, max-age=86400"
			header /favicon.ico Cache-Control "public, max-age=86400"
			header /apple-icon.png Cache-Control "public, max-age=86400"
			root * /srv/static
			file_server {
				precompressed br gzip
				pass_thru
			}
			import app
		}
	}
	handle {
		encode zstd gzip
		import app
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
