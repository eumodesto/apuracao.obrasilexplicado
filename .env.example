# One long-lived Node process by default.
TSE_POLL_INTERVAL_MS=3000
TSE_STALE_AFTER_MS=120000
# How often browsers ask this server for results (the TSE is still read every TSE_POLL_INTERVAL_MS).
CLIENT_POLL_INTERVAL_MS=10000
TSE_CACHE_DIR=.cache/tse
# Public origin for absolute Open Graph URLs and Pix notifications.
SITE_URL=http://localhost:3000

# --- Access: login, free time and Pix payment ---
# Signs the login cookie. Required in production: at least 32 random characters.
SESSION_SECRET=
# Login is e-mail (or username) and password; see docs/ACCESS_AND_PAYMENT.md.
# `npm run dev` also offers a test login without password.
# Mercado Pago > Your integrations > Credentials (production Access Token).
# Without it, `npm run dev` offers a simulated Pix instead.
MP_ACCESS_TOKEN=
# Public key for the card form inside the site (Mercado Pago > Credentials > Public Key).
MP_PUBLIC_KEY=
# Mercado Pago > Webhooks > secret signature. Optional but recommended.
MP_WEBHOOK_SECRET=
# Postgres (for example Neon or Supabase). Required on Vercel.
# Without it, local runs keep users and payments in .data/access.json.
DATABASE_URL=
# Redis/Valkey for the chat across several servers (pub/sub, slow mode, people online).
# Without it, a single process keeps the chat in memory.
REDIS_URL=
FREE_SECONDS=60
# Set to true to pause the free minute until the TSE publishes the first national result.
# FREE_TIME_WAIT_FOR_COUNT=true
# Team e-mails with full access, without free time or payment (comma-separated).
STAFF_EMAILS=admin1@example.com,admin2@example.com
# Administrators (/admin): suspend and delete accounts, delete messages. They also have full access.
ADMIN_EMAILS=admin1@example.com,admin2@example.com
ACCESS_PRICE_BRL=5.00
# When the 2nd-round count opens; before it, `/` still opens the panel with 1st-round boards.
COUNT_STARTS_AT=2026-10-25T17:00:00-03:00
# Legacy only. Paid access is lifetime after one Mercado Pago approval; this date is ignored.
# PAID_ACCESS_ENDS_AT=2026-10-31T23:59:59-03:00
